# Abono Web — example environment
#
# Copy to .env.local and adjust. Never commit real credentials.
# Next.js loads .env.local automatically.

# ---- API ----
# Base URL of the Rails API. NEXT_PUBLIC_ is exposed to the browser, so only
# put non-sensitive values behind that prefix.
NEXT_PUBLIC_API_URL=http://localhost:3000

# ---- Dev server ----
# The API owns port 3000, so the web app runs on 3001 (see package.json).
PORT=3001
