# Abono API — example environment
#
# Copy to .env and adjust. Every value here is a placeholder: never commit
# real credentials. The defaults below match a stock local PostgreSQL, so a
# fresh clone runs without setting any of these.
#
# Note: Rails does not load .env on its own (no dotenv gem yet). Export these
# in your shell, or add dotenv-rails if you'd rather use a file.

# ---- Database ----
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=abono_api_development

# ---- Rails ----
# Port 3000 for the API; the Next.js app runs on 3001 to avoid a collision.
PORT=3000
RAILS_MAX_THREADS=5

# ---- Later phases ----
# Disbursement (Phase 4), Claude API (Phase 6) and observability (Phase 7)
# credentials belong here when those phases land. Sandbox keys only until
# Phase 8 — production secrets go in Rails encrypted credentials or a
# secrets manager, never in this file.
